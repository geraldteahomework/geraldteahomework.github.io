{
  "id": "./",
  "name": "Homework",
  "short_name": "Homework",
  "description": "Homework checklist and calendar",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "categories": ["education", "productivity"],
  "background_color": "#f4f5f9",
  "theme_color": "#4f6df5",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add homework",
      "short_name": "Add",
      "url": "./#add",
      "icons": [{ "src": "./icons/sc-add.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Timetable",
      "short_name": "Timetable",
      "url": "./#timetable",
      "icons": [{ "src": "./icons/sc-timetable.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "url": "./#calendar",
      "icons": [{ "src": "./icons/sc-calendar.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
